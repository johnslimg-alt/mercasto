OLLAMA_URL=http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_CHAT_MODEL=qwen3-vl:4b-instruct
OLLAMA_TIMEOUT=150

# Search discovery remains exact-first. Semantic retrieval is fallback-only and can be disabled instantly.
SEMANTIC_DISCOVERY_ENABLED=true
SEMANTIC_DISCOVERY_MODE=fallback_only
SEMANTIC_DISCOVERY_MODEL=nomic-embed-text
SEMANTIC_DISCOVERY_TIMEOUT_SECONDS=3
SEMANTIC_DISCOVERY_MAX_DISTANCE=0.35

# AI moderation safety controls. Assist-only is hard-coded in backend/config/ai_moderation.php.
AI_MODERATION_ENABLED=true
AI_MODERATION_MAX_RUNTIME_SECONDS=150
AI_MODERATION_GATEWAY_URL=http://mercasto-ai-gateway:8080
AI_MODERATION_GATEWAY_TIMEOUT=150
# Required shared secret for Laravel -> private Python AI gateway. Never commit a real value.
MERCASTO_AI_INTERNAL_TOKEN=
PORT=5000


# Marketing analytics / pixels
# IDs are public tag identifiers, not API secrets. Set VITE_ANALYTICS_ENABLED=false to disable browser analytics.
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_VERBOSE=false
VITE_META_PIXEL_ID=4595315270748335
VITE_MICROSOFT_UET_TAG_ID=
VITE_CLARITY_PROJECT_ID=

# Google Analytics 4 server-side purchases
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-VX87HQC817
GOOGLE_ANALYTICS_API_SECRET=
GOOGLE_ANALYTICS_ENDPOINT=https://www.google-analytics.com/mp/collect

# Meta server-side events
FACEBOOK_PIXEL_ID=4595315270748335
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v25.0
FACEBOOK_TEST_EVENT_CODE=

# TikTok server-side events
TIKTOK_PIXEL_CODE=D9C3HKBC77UBS5FSD7C0
TIKTOK_ACCESS_TOKEN=
TIKTOK_EVENTS_API_ENDPOINT=https://business-api.tiktok.com/open_api/v1.3/event/track/
TIKTOK_TEST_EVENT_CODE=

# Grafana monitoring dashboard (only used with --profile monitoring)
GRAFANA_PASSWORD=

VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=mercasto.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Web Push (generate a matching VAPID key pair; never commit real keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Buyer conversion nudge rollout (0 = disabled; enable only after launch stabilization)
VITE_BUYER_NUDGE_ROLLOUT_PERCENT=0