# Mercasto production environment template
# Copy values into the real production environment manager only.
# Do not commit live operational values.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://mercasto.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis

FILESYSTEM_DISK=public

# Clip processing-fee fraction applied to provider-backed payments when the
# accounting export computes fee_amount / net_amount. Leave unset (0) until the
# signed Clip merchant contract rate is confirmed by finance: with no rate the
# export reports fee tracking as not configured and net equals gross.
# Example: CLIP_FEE_RATE=0.036
CLIP_FEE_RATE=
