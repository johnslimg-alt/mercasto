{
  "name": "mercasto",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:ci": "eslint . --quiet",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "category-schema:audit": "node scripts/category-schema-audit.mjs",
    "preview": "vite preview",
    "smoke:prod": "bash scripts/production-smoke.sh",
    "smoke:security": "bash scripts/security-probes.sh",
    "smoke:error-mode": "bash scripts/production-error-mode-smoke.sh",
    "smoke:routes": "bash scripts/listing-route-smoke.sh",
    "smoke:route-audit": "bash scripts/production-route-audit.sh",
    "smoke:seo": "bash scripts/seo-public-audit.sh",
    "smoke:copy": "bash scripts/public-copy-scan.sh",
    "smoke:cache-headers": "bash scripts/cache-header-smoke.sh",
    "smoke:auth-providers": "bash scripts/auth-providers-smoke.sh",
    "smoke:sms-readiness": "bash scripts/sms-readiness-smoke.sh",
    "smoke:env-readiness": "bash scripts/env-readiness-smoke.sh",
    "smoke:category-data": "bash scripts/category-data-smoke.sh",
    "smoke:category-filters": "bash scripts/category-filter-smoke.sh",
    "smoke:backup-freshness": "bash scripts/backup-freshness-smoke.sh",
    "smoke:launch-artifacts": "bash scripts/launch-artifact-inventory.sh",
    "smoke:legal-readiness": "bash scripts/legal-readiness-smoke.sh",
    "launch:status": "bash scripts/launch-status-summary.sh",
    "smoke:business-profile": "bash scripts/business-profile-smoke.sh",
    "smoke:share-og": "bash scripts/share-og-smoke.sh",
    "smoke:public-manifests": "bash scripts/public-manifest-smoke.sh",
    "smoke:port-ownership": "bash scripts/port-ownership-smoke.sh",
    "e2e:install": "npx playwright install --with-deps chromium",
    "e2e:public": "npx playwright test tests/e2e/public-smoke.spec.js",
    "e2e:ai-brand": "playwright test tests/e2e/ai-brand-positioning.spec.js",
    "e2e:public:ci": "bash scripts/public-e2e-ci.sh",
    "check:session-config": "bash scripts/session-config-scan.sh",
    "check:payment-webhook-idempotency": "bash scripts/payment-webhook-idempotency-scan.sh",
    "check:media-upload-validation": "bash scripts/media-upload-validation-scan.sh",
    "check:static-safety": "bash scripts/static-safety-scans.sh",
    "check:ai-description-editor": "bash scripts/ai-description-editor-gate.sh",
    "smoke:all": "npm run check:scripts && npm run check:compose && npm run check:static-safety && npm run check:ai-description-editor && npm run smoke:port-ownership && npm run smoke:prod && npm run smoke:category-filters && npm run smoke:auth-providers && npm run smoke:sms-launch-mode && npm run smoke:business-profile && npm run smoke:share-og && npm run smoke:public-manifests && npm run smoke:security && npm run smoke:error-mode && npm run smoke:session-security && npm run smoke:routes && npm run smoke:route-audit && npm run smoke:seo && npm run smoke:cache-headers && npm run smoke:copy && npm run smoke:legal-readiness",
    "smoke:full": "npm run smoke:all && npm run maintenance:precheck",
    "verify:quick": "npm run smoke:all",
    "verify:prod": "npm run smoke:full",
    "verify:launch": "REQUIRE_ENV_READY=1 REQUIRE_CATEGORY_DATA_READY=1 REQUIRE_LEGAL_READY=1 npm run smoke:env-readiness && REQUIRE_CATEGORY_DATA_READY=1 npm run smoke:category-data && REQUIRE_LEGAL_READY=1 npm run smoke:legal-readiness && npm run smoke:sms-launch-mode && REQUIRE_SMS_READY=0 npm run smoke:all",
    "gate:prod": "npm run check:scripts && npm run check:compose && npm run check:recovery && npm run check:static-safety && npm run check:ai-description-editor && npm run smoke:port-ownership && npm run smoke:auth-providers && npm run smoke:business-profile && npm run smoke:share-og && npm run smoke:public-manifests && npm run smoke:cache-headers && npm run build && npm run verify:quick",
    "maintenance:precheck": "bash scripts/os-maintenance-precheck.sh",
    "smoke": "npm run smoke:prod",
    "check:compose": "DB_PASSWORD=${DB_PASSWORD:-ci} REDIS_PASSWORD=${REDIS_PASSWORD:-ci} GRAFANA_PASSWORD=${GRAFANA_PASSWORD:-ci} docker compose config >/tmp/mercasto_compose_base.$(id -u).out && DB_PASSWORD=${DB_PASSWORD:-ci} REDIS_PASSWORD=${REDIS_PASSWORD:-ci} GRAFANA_PASSWORD=${GRAFANA_PASSWORD:-ci} docker compose -f docker-compose.yml -f docker-compose.override.yml config >/tmp/mercasto_compose_override.$(id -u).out",
    "check:scripts": "find scripts -type f -name '*.sh' -print0 | xargs -0 -r -n1 bash -n",
    "check:recovery": "node scripts/check-recovery-guards.mjs && npm run check:npm-audit-policy",
    "check:payment-retention": "bash scripts/payment-retention-scan.sh",
    "check:cache-policy": "bash scripts/cache-policy-scan.sh",
    "check:npm-audit-policy": "node scripts/npm-audit-policy.mjs",
    "smoke:sms-launch-mode": "SMS_LAUNCH_MODE=disabled bash scripts/sms-launch-mode-smoke.sh",
    "e2e:launch:isolated": "bash scripts/run-isolated-launch-e2e.sh",
    "check:csrf-session": "bash scripts/csrf-session-contract-gate.sh",
    "smoke:session-security": "bash scripts/production-session-security-smoke.sh",
    "check:origin-edge": "bash scripts/origin-edge-security-gate.sh",
    "smoke:origin-edge": "bash scripts/origin-edge-security-smoke.sh",
    "check:payment-payload-privacy": "bash scripts/payment-payload-privacy-gate.sh",
    "check:security-audit": "bash scripts/security-audit-gate.sh",
    "smoke:security-audit": "bash scripts/security-audit-smoke.sh",
    "check:launch-readiness-contract": "bash scripts/launch-readiness-contract-gate.sh",
    "smoke:security-headers": "bash scripts/security-header-smoke.sh",
    "smoke:offsite-backup": "bash scripts/offsite-backup-smoke.sh",
    "check:offsite-backup": "bash scripts/offsite-backup-contract-gate.sh",
    "smoke:mobile-association": "bash scripts/mobile-association-smoke.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.49.0",
    "dotenv": "^17.4.2",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "laravel-echo": "^2.3.4",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.8.0",
    "pusher-js": "^8.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "react-router-dom": "7.18.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "nanoid": "^3.3.18",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.9"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
