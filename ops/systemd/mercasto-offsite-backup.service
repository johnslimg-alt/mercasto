[Unit]
Description=Mercasto encrypted off-host PostgreSQL replication to Cloudflare R2
After=docker.service network-online.target
Wants=network-online.target
OnFailure=mercasto-offsite-backup-alert.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/mercasto-offsite-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=30min
