[Unit]
Description=Mercasto off-host media restore drill
After=network-online.target
Wants=network-online.target
OnFailure=mercasto-media-offsite-backup-alert.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/mercasto-media-offsite-backup --restore-drill
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=120min
