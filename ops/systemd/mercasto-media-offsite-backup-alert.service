[Unit]
Description=Record Mercasto off-host media backup failure

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/bin/sh -c "install -d -m 700 /var/lib/mercasto-media-offsite-backup; date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ > /var/lib/mercasto-media-offsite-backup/FAILED; logger -p authpriv.err -t mercasto-media-offsite-backup Media backup replication failed; inspect systemctl status mercasto-media-offsite-backup.service"
