[Unit]
Description=Mercasto encrypted off-host media replication to Cloudflare R2
After=network-online.target
Wants=network-online.target
OnFailure=mercasto-media-offsite-backup-alert.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/mercasto-media-offsite-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=90min
