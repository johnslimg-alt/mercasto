limit_req_zone $binary_remote_addr zone=mcp_plugin_per_ip:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=mcp_plugin_conn_per_ip:10m;

server {
    listen 80;
    server_name mcp.mercasto.com;

    client_max_body_size 1m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location = /healthz {
        proxy_pass http://__MCP_BRIDGE_HOST__:18780;
        proxy_http_version 1.1;
        proxy_set_header Host mcp.mercasto.com;
        proxy_set_header X-Forwarded-Proto http;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}
