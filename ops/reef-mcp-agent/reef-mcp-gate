#!/usr/bin/env bash
set -euo pipefail

operation="${1:-}"
shift || true

redact() {
  sed -E 's/(password|token|secret|authorization|cookie|api[_-]?key)([=: ][^[:space:]]+)/\1=***REDACTED***/Ig'
}

case "$operation" in
  server_status)
    echo '== hostname =='
    hostname
    echo '== uptime =='
    uptime
    echo '== memory =='
    free -h
    echo '== disk =='
    df -h /
    echo '== failed units =='
    systemctl --failed --no-pager --plain || true
    ;;

  reef_crm_status)
    echo '== containers =='
    docker ps -a --filter 'name=reef-crm' --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    echo '== health =='
    curl -fsS --connect-timeout 2 --max-time 5 http://127.0.0.1:3100/api/health || true
    echo
    ;;

  reef_crm_logs)
    lines="${1:-80}"
    case "$lines" in
      ''|*[!0-9]*) echo 'invalid lines' >&2; exit 64 ;;
    esac
    if [ "$lines" -lt 10 ] || [ "$lines" -gt 200 ]; then
      echo 'lines must be between 10 and 200' >&2
      exit 64
    fi
    docker logs --tail="$lines" reef-crm 2>&1 | redact
    ;;

  network_snapshot)
    echo '== listeners =='
    ss -lntp 2>/dev/null | head -120
    echo '== firewall =='
    if command -v ufw >/dev/null 2>&1; then
      ufw status verbose || true
    else
      echo 'ufw not installed'
    fi
    ;;

  mcp_agent_status)
    systemctl show reef-mcp-agent.service --no-pager \
      -p LoadState -p ActiveState -p SubState -p UnitFileState -p MainPID -p NRestarts -p ExecMainStatus || true
    echo '== listener =='
    ss -lntp 2>/dev/null | grep '127.0.0.1:8765' || true
    echo '== local health =='
    curl -fsS --connect-timeout 2 --max-time 5 http://127.0.0.1:8765/health || true
    echo
    ;;

  *)
    echo "unsupported operation: $operation" >&2
    exit 64
    ;;
esac
